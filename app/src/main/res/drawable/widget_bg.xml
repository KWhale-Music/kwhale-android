<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="45"
                android:startColor="#7A5CFF"
                android:centerColor="#3A2A5A"
                android:endColor="#2F6BFF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="#17141F" />
        </shape>
    </item>
</layer-list>
