<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base: HTTPS only. The public release API (https://music.dueattendant149.org)
         rides on TLS. Cleartext is limited to the local self-hosted loopback used
         with adb-reverse / the Android emulator; debug builds additionally permit
         cleartext for arbitrary LAN dev hosts (see src/debug/res/xml/). -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
